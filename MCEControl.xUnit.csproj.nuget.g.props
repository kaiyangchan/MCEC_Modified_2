    <Import Project="$(NuGetPackageRoot)microsoft.codecoverage\18.7.0\build\netstandard2.0\Microsoft.CodeCoverage.props" Condition="Exists('$(NuGetPackageRoot)microsoft.codecoverage\18.7.0\build\netstandard2.0\Microsoft.CodeCoverage.props')" />
